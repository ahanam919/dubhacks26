# Copy this file to mobile/.env (never commit .env) and fill in the values.

# Google Maps key for Android (Maps SDK for Android). Only used by development
# builds (npx expo run:android), not Expo Go.
GOOGLE_MAPS_ANDROID_API_KEY=

# API the app talks to. Leave unset to use the deployed server.
# EXPO_PUBLIC_API_URL=https://104-238-157-17.nip.io
# Copy to mobile/.env.local (ignored by git). Where the app finds the API.
# Leave unset for simulators: Android emulator uses http://10.0.2.2:3000, iOS simulator http://localhost:3000.
# Physical phone on the same Wi-Fi: your Mac's LAN IP, e.g. http://192.168.1.20:3000
# Deployed server: its HTTPS URL, e.g. https://104-238-157-17.nip.io
EXPO_PUBLIC_API_URL=
