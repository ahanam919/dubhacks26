# Database (Tiger Data connection string)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Gemini API
GEMINI_API_KEY=your-key-here

# Server
PORT=3000
NODE_ENV=development

# Ingestion worker
INGEST_USER_AGENT=LocalSwapBot/0.1 (contact: your-email@example.com)
INGEST_DELAY_MS=3000
INGEST_TOKEN=change-me

# Optional, if you use a places API for finding shops and chains
PLACES_API_KEY=your-key-here

SQUARE_ACCESS_TOKEN=token-here
SQUARE_LOCATION_ID=id-here
SQUARE_ENV=sandbox

# Geofence (api/src/geofence/routes.ts)
GEOFENCE_COOLDOWN_MIN=180
# Uncomment for no alerts 9pm to 7am Seattle time:
# GEOFENCE_QUIET_HOURS=21-7
