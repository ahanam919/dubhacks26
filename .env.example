# Database (Tiger Data connection string)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Gemini API
GEMINI_API_KEY=your-key-here

# Server
PORT=3000
NODE_ENV=development

# Ingestion worker
INGEST_USER_AGENT=LocalSwapBot/0.1 (contact: your-email@example.com)
INGEST_DELAY_MS=3000
INGEST_TOKEN=change-me

# Optional, if you use a places API for finding shops and chains
PLACES_API_KEY=your-key-here

# Square sandbox only. Never put real production credentials here.
# The API refuses to start unless SQUARE_ENV is exactly "sandbox".
SQUARE_ENV=sandbox
# Access token of the Demo Cafe (sandbox) test account (Developer Console >
# Sandbox test accounts > Demo Cafe > authorization). Not the app's default token.
SQUARE_ACCESS_TOKEN=
# Location of that same account. `cd api && npm run square:check` lists it.
SQUARE_LOCATION_ID=
# Square-Version header, a date from Square's API changelog (e.g. 2026-09-16).
SQUARE_VERSION=
# Optional demo helpers:
# true enables POST /dev/order/:id/advance (moves an order to accepted, then ready)
ENABLE_DEV_ROUTES=false
# true makes GET /order/:id fake the status from elapsed time (labeled in the app)
SIMULATE_STATUS=false


SQUARE_ACCESS_TOKEN=token-here
SQUARE_LOCATION_ID=id-here
SQUARE_ENV=sandbox

# Geofence (api/src/geofence/routes.ts)
GEOFENCE_COOLDOWN_MIN=180
# Uncomment for no alerts 9pm to 7am Seattle time:
# GEOFENCE_QUIET_HOURS=21-7
